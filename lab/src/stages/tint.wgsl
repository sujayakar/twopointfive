// The lamps' light as it arrives: the first one's by its own shadow; the others' as the hue of what comes through, for how much there is stays exact and which of it is seen was asked lamp by lamp.
// outT: rgb all standing lamps', shadows and all (and the sun's, where a lamp outshines it), a the torches' with nothing in the way; then the fractions of torches, highlight, sun.
@compute @workgroup_size(8, 8) fn main(@builtin(global_invocation_id) id: vec3u) {
  let dim = vec2u(frame.size.xy); if (id.x >= dim.x || id.y >= dim.y) { return; } let t = textureLoad(lampU, id.xy, 0); let u = lightAll(t); let v = max(textureLoad(vis, id.xy, 0), vec4f(0.0)); let fl = lightFirst(t); let lamp = fl.a > 0.5; var E = vec3f(0.0); if (lamp) { E = fl.rgb * v.w; let p = unpackPx(textureLoad(surf, id.xy, 0), pxRay(id.xy)); if (p.leaf) { let s = pxSurf(p); let c = dot(p.n, normalize(lamps[u32(fl.a) - 1u].at - p.x)); let m = lum(p.albedo); let t = lum(s.through); E *= select(t * -c, m * c, c > 0.0) / max(0.25 * (m + t), 1e-4); } }     /* (a leaf has a lit side and one the light comes through; the sum it will meet takes it as one of many) */
  let q4 = vec4f(v.y, v.z, select(v.w, 0.0, lamp), 0.0); let l0 = lum(u.rgb); if (l0 <= 1e-5) { textureStore(outT, id.xy, packLight(vec4f(E, u.a), q4)); return; }
  let p = unpackPx(textureLoad(surf, id.xy, 0), pxRay(id.xy)); let hd = vec2i(textureDimensions(tone)); let b = vec2f(id.xy) / 2.0 - 0.25; let q0 = vec2i(floor(b)); let f = b - floor(b); var a = vec3f(0.0); var ws = 0.0;
  for (var k = 0; k < 4; k++) { let q = clamp(q0 + vec2i(k & 1, k >> 1u), vec2i(0), hd - 1); let fq = min(q * 2, vec2i(frame.size.xy) - 1); let s = unpackPx(textureLoad(surf, fq, 0), pxRay(vec2u(fq))); if (s.sky) { continue; } let w = (select(1.0 - f.x, f.x, (k & 1) == 1) * select(1.0 - f.y, f.y, k > 1) + 0.01) * (pow(sat(dot(s.n, p.n)), 8.0) * exp(-abs(dot(s.x - p.x, p.ng)) / (0.003 * p.t + 0.01)) + 1e-4); a += textureLoad(tone, q, 0).rgb * w; ws += w; }
  a /= max(ws, 1e-6); let l1 = lum(a * u.rgb); var o = u.rgb; if (l1 > 1e-4 * l0) { o = u.rgb * clamp(a * (l0 / l1), vec3f(0.0), vec3f(6.0)); } textureStore(outT, id.xy, packLight(vec4f(E + o * v.x, u.a), q4));
}
