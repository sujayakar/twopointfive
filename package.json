{
  "name": "twopointsix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "TPS_LOCAL_CLOUD=1 bun run tools/serve.ts",
    "build": "bun run tools/build.ts",
    "typecheck": "node vendor/typescript/bin/tsc --noEmit -p tsconfig.json",
    "typecheck:qa": "node --max-old-space-size=8192 vendor/typescript/bin/tsc --noEmit -p tools/qa/tsconfig.json",
    "map:export": "bun run tools/levels/export.ts",
    "map:plan": "bun run tools/qa/map-plan.ts",
    "qa": "node vendor/typescript/bin/tsc --noEmit -p tsconfig.json && bun run tools/qa/checks.ts && (cd rust/game_start && cargo run --release --bin gate)"
  }
}
